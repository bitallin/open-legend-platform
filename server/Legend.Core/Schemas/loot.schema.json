{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlegend.local/schemas/loot.schema.json",
  "title": "Open Legend loot tables",
  "type": "array",
  "maxItems": 2000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["lootTableId", "entries"],
    "properties": {
      "lootTableId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" },
      "entries": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["itemId"],
          "properties": {
            "itemId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" },
            "countMin": { "type": "integer", "minimum": 0, "maximum": 9999 },
            "countMax": { "type": "integer", "minimum": 0, "maximum": 9999 },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
