{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlegend.local/schemas/combos.schema.json",
  "title": "Open Legend hero combos",
  "type": "object",
  "additionalProperties": false,
  "required": ["combos"],
  "properties": {
    "hejiRangeCells": { "type": "integer", "minimum": 1, "maximum": 32 },
    "combos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comboId", "playerClassId", "heroClassId", "skillId"],
        "properties": {
          "comboId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "playerClassId": { "type": "string", "minLength": 1, "maxLength": 32 },
          "heroClassId": { "type": "string", "minLength": 1, "maxLength": 32 },
          "skillId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "cooldownMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
          "mpCostPlayer": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "mpCostHero": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "damageMultiplier": { "type": "number", "minimum": 0.1, "maximum": 100 }
        }
      }
    }
  }
}
