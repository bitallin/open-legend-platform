{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlegend.local/schemas/items.schema.json",
  "title": "Open Legend items",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "displayName", "kind"],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": {
            "type": "string",
            "enum": [
              "consumable",
              "material",
              "equipment",
              "skillbook",
              "mount_unlock",
              "fashion_unlock",
              "pet_unlock",
              "recall",
              "random"
            ]
          },
          "slot": {
            "type": "string",
            "enum": [
              "",
              "weapon",
              "armor",
              "helmet",
              "necklace",
              "bracelet",
              "bracelet2",
              "ring",
              "ring2",
              "belt",
              "boots",
              "torch"
            ]
          },
          "paperdoll": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "atkBonus": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "defBonus": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "maxHpBonus": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "enhanceAtkPerLevel": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "enhanceDefPerLevel": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "enhanceHpPerLevel": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "requiredClass": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "requiredLevel": { "type": "integer", "minimum": 0, "maximum": 999 },
          "healHp": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "healMp": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "teachesSkillId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "appliesBuffId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "unlockMountId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "unlockFashionId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "unlockPetId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "sellPriceGold": { "type": "integer", "minimum": 0, "maximum": 100000000 },
          "weight": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "needsIdentify": { "type": "boolean" },
          "recallMapId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          },
          "setId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^$|^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "enhanceRules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetLevel", "costGold", "successRate"],
        "properties": {
          "targetLevel": { "type": "integer", "minimum": 1, "maximum": 32 },
          "costGold": { "type": "integer", "minimum": 0, "maximum": 100000000 },
          "successRate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
