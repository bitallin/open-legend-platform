# Copy to keystore.properties (gitignored) or export the LEGEND_ANDROID_* env vars.
# NEVER commit real passwords or .keystore / .jks files.

storeFile=/absolute/path/to/legend-release.keystore
storePassword=CHANGE_ME_STORE
keyAlias=legend
keyPassword=CHANGE_ME_KEY

# Equivalent environment variables consumed by Assets/Editor/AndroidBuild.cs:
#   LEGEND_ANDROID_KEYSTORE=/absolute/path/to/legend-release.keystore
#   LEGEND_ANDROID_KEYSTORE_PASS=CHANGE_ME_STORE
#   LEGEND_ANDROID_KEYALIAS=legend
#   LEGEND_ANDROID_KEYALIAS_PASS=CHANGE_ME_KEY
