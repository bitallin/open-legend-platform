@model Legend.Admin.Pages.Entities.EntityListModelBase
@{
  var kind = Model.Desc.Kind;
  var bindPage = kind switch
  {
    "monsters" => "/Assets/BindMonster",
    "items" => "/Assets/BindItem",
    "maps" => "/Assets/BindMap",
    _ => (string?)null
  };
  var view = Model.ViewMode;
  var missingOnly = Model.MissingOnly;
}
<nav class="crumbs"><a asp-page="/Studio/Index" asp-route-packId="@Model.PackId">内容总览</a> / <span>@Model.Desc.TitleZh</span></nav>

<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
    <div style="flex:1.4">
      <label>搜索</label>
      <input type="text" name="q" value="@Model.Q" placeholder="ID / 名称" />
    </div>
    <div>
      <label>视图</label>
      <input type="hidden" name="view" value="@view" />
      <label class="tiny" style="display:flex;gap:.4rem;align-items:center;color:var(--text);margin:0 0 12px">
        <input type="checkbox" name="missingOnly" value="true" @(missingOnly ? "checked" : null) onchange="this.form.submit()" /> 仅缺图
      </label>
    </div>
    <div><button class="btn btn-primary" type="submit">筛选</button></div>
  </form>
  <div class="toolbar">
    @if (Model.CanWrite)
    {
      <a class="btn btn-primary" asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@Model.PackId">新建</a>
    }
    @if (kind == "maps")
    {
      <a class="btn btn-primary" asp-page="/Entities/MapSpawns" asp-route-packId="@Model.PackId">按地图配置刷怪</a>
    }
    @if (kind == "monsters")
    {
      <a class="btn" asp-page="/Entities/MapSpawns" asp-route-packId="@Model.PackId">地图刷怪表</a>
    }
    <a class="btn" asp-page="/Configs/Edit" asp-route-packId="@Model.PackId" asp-route-path="@(Model.Desc.IsMapFiles ? "maps/novice_plain.json" : Model.Desc.RelativePath)">JSON 兜底</a>
    <div class="view-toggle" role="group" aria-label="视图切换">
      <a class="@(view=="cards"?"active":"")" href="?packId=@Model.PackId&q=@Uri.EscapeDataString(Model.Q)&view=cards&missingOnly=@missingOnly.ToString().ToLowerInvariant()">卡片</a>
      <a class="@(view=="table"?"active":"")" href="?packId=@Model.PackId&q=@Uri.EscapeDataString(Model.Q)&view=table&missingOnly=@missingOnly.ToString().ToLowerInvariant()">表格</a>
    </div>
    <span class="muted">共 @Model.Rows.Count 条@(missingOnly ? "（缺图）" : "")</span>
  </div>
</div>

@if (Model.Rows.Count == 0)
{
  <div class="card"><div class="empty">
    暂无数据。
    @if (kind == "monsters" && Model.PackId != "sample-classic")
    {
      <span>当前包 <code>@Model.PackId</code> 可能没有怪物模板。</span>
      <a href="?packId=sample-classic">切换到 sample-classic</a>
    }
    else if (Model.CanWrite)
    {
      <a asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@Model.PackId">新建一条</a>
    }
  </div></div>
}
else if (view == "table")
{
<div class="card">
  <div class="table-scroll">
  <table class="data">
    <thead>
      <tr>
        <th>外观</th>
        @foreach (var c in Model.Desc.ListColumns)
        {
          <th>@c</th>
        }
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
      <tr>
        <td>
          @if (r.ThumbUrl is not null)
          { <img class="thumb-sm lightbox-src" src="@r.ThumbUrl" alt="" /> }
          else
          { <span class="badge warn">缺图</span> }
        </td>
        @foreach (var c in Model.Desc.ListColumns)
        {
          <td>@(r.Cols.GetValueOrDefault(c) ?? "")</td>
        }
        <td class="nowrap">
          <a class="btn btn-sm btn-primary" asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@Model.PackId" asp-route-id="@r.Id">编辑</a>
          @if (kind == "maps")
          {
            <a class="btn btn-sm" asp-page="/Entities/MapSpawns" asp-route-packId="@Model.PackId" asp-route-mapId="@r.Id">刷怪</a>
          }
          @if (bindPage is not null)
          {
            <a class="btn btn-sm" asp-page="@bindPage" asp-route-packId="@Model.PackId" asp-route-id="@r.Id">外观</a>
          }
          @if (Model.CanWrite)
          {
            <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('删除 @r.Id ？');">
              <input type="hidden" name="packId" value="@Model.PackId" />
              <input type="hidden" name="id" value="@r.Id" />
              <button class="btn btn-sm btn-danger" type="submit">删</button>
            </form>
          }
        </td>
      </tr>
    }
    </tbody>
  </table>
  </div>
</div>
}
else
{
<div class="entity-board">
@foreach (var r in Model.Rows)
{
  <div class="ecard @(r.ThumbUrl is null ? "missing" : "")">
    <a class="ecard-preview" asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@Model.PackId" asp-route-id="@r.Id">
      @if (r.ThumbUrl is not null)
      {
        <img class="lightbox-src" src="@r.ThumbUrl" alt="@r.Name" loading="lazy" />
      }
      else
      {
        <div class="empty-art">
          <strong>缺外观</strong>
          <span>点击编辑或去绑定</span>
        </div>
      }
      <div class="ecard-overlay">
        <div class="name">@r.Name</div>
        <div class="id">@r.Id</div>
      </div>
    </a>
    <div class="ecard-body">
      <div class="ecard-meta">
        @foreach (var c in Model.Desc.ListColumns.Take(3))
        {
          var v = r.Cols.GetValueOrDefault(c) ?? "";
          if (!string.IsNullOrEmpty(v) && c != Model.Desc.IdProperty && c != Model.Desc.DisplayProperty)
          {
            <span class="badge">@c:@v</span>
          }
        }
        @if (r.ThumbUrl is null) { <span class="badge warn">缺图</span> }
      </div>
      <div class="ecard-actions">
        <a class="btn btn-sm btn-primary" asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@Model.PackId" asp-route-id="@r.Id">编辑</a>
        @if (kind == "maps")
        {
          <a class="btn btn-sm" asp-page="/Entities/MapSpawns" asp-route-packId="@Model.PackId" asp-route-mapId="@r.Id">刷怪</a>
        }
        @if (bindPage is not null)
        {
          <a class="btn btn-sm" asp-page="@bindPage" asp-route-packId="@Model.PackId" asp-route-id="@r.Id">@(r.ThumbUrl is null ? "上传外观" : "外观")</a>
        }
        @if (Model.CanWrite)
        {
          <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('删除 @r.Id ？');">
            <input type="hidden" name="packId" value="@Model.PackId" />
            <input type="hidden" name="id" value="@r.Id" />
            <button class="btn btn-sm btn-danger" type="submit">删</button>
          </form>
        }
      </div>
    </div>
  </div>
}
</div>
}
