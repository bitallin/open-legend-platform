@using global::System.Security.Claims
@inject Legend.Admin.Services.PackPreference PackPref
@{
    var navPack = PackPref.Current();
    var path = Context.Request.Path.Value ?? "";
    string A(string p) => path.Equals(p, StringComparison.OrdinalIgnoreCase) || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase) || (p != "/" && path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    // Index special-case: only exact /
    string AIndex() => (path == "/" || path.Equals("/Index", StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var user = User.Identity?.Name ?? "";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var initial = string.IsNullOrEmpty(user) ? "?" : char.ToUpperInvariant(user[0]).ToString();
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "运营后台") · Open Legend Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
<div class="app-shell">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark">OL</div>
      <div class="brand-text">Open Legend<small>传奇运营控制台</small></div>
    </div>
    <nav class="nav">
      <div class="nav-sec">总览</div>
      <a class="@AIndex()" asp-page="/Index"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10.5V20h14v-9.5"/></svg></span><span class="label">仪表盘</span></a>

      <div class="nav-sec">内容配置</div>
      <a class="@A("/Studio")" asp-page="/Studio/Index" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span class="label">内容总览</span></a>
      <a class="@A("/Configs")" asp-page="/Configs/Index" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg></span><span class="label">配置目录</span></a>
      <a class="@A("/Entities/Monsters")" asp-page="/Entities/Monsters" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="10" r="5"/><path d="M8 20c1.5-2 6.5-2 8 0"/><path d="M9 9h.01M15 9h.01"/></svg></span><span class="label">怪物</span></a>
      <a class="@A("/Entities/MapSpawns")" asp-page="/Entities/MapSpawns" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M12 2 4 7v10l8 5 8-5V7l-8-5z"/><circle cx="12" cy="12" r="2.5"/></svg></span><span class="label">地图刷怪</span></a>
      <a class="@A("/Entities/Loot")" asp-page="/Entities/Loot" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 8l7-3 7 3v8l-7 3-7-3V8z"/></svg></span><span class="label">爆率/掉落</span></a>
      <a class="@A("/Entities/Items")" asp-page="/Entities/Items" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4z"/></svg></span><span class="label">物品/装备</span></a>
      <a class="@A("/Entities/Skills")" asp-page="/Entities/Skills" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 10-14h-7l0-6z"/></svg></span><span class="label">技能</span></a>
      <a class="@A("/Entities/Maps")" asp-page="/Entities/Maps" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg></span><span class="label">地图</span></a>
      <a class="@A("/Entities/Npcs")" asp-page="/Entities/Npcs" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 14.5-4 16 0"/></svg></span><span class="label">NPC</span></a>
      <a class="@A("/Entities/Shops")" asp-page="/Entities/Shops" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M3 9h18l-1 11H4L3 9z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg></span><span class="label">商店</span></a>
      <a class="@A("/Entities/Quests")" asp-page="/Entities/Quests" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M8 4h8v16l-4-2-4 2V4z"/><path d="M10 8h4M10 12h4"/></svg></span><span class="label">任务</span></a>
      <a class="@A("/Entities/Gameplay")" asp-page="/Entities/Gameplay" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg></span><span class="label">玩法数值</span></a>

      <div class="nav-sec">画面与素材</div>
      <a class="@A("/Assets")" asp-page="/Assets/Index" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="m21 16-5-5-4 4-2-2-5 5"/></svg></span><span class="label">素材库</span></a>
      <a class="@A("/Assets/UiSkin")" asp-page="/Assets/UiSkin" asp-route-packId="@navPack"><span class="nav-ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/></svg></span><span class="label">UI 皮肤</span></a>
      <a class="@A("/Assets/Guide")" asp-page="/Assets/Guide"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg></span><span class="label">操作指南</span></a>
      <a class="@A("/Assets/Catalog")" asp-page="/Assets/Catalog"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M8 4h11v14H8z"/><path d="M5 6h3v14H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z"/></svg></span><span class="label">JSON 清单</span></a>

      <div class="nav-sec">商城与经济</div>
      <a class="@A("/Economy/Mall")" asp-page="/Economy/Mall"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg></span><span class="label">商城 SKU</span></a>
      <a class="@A("/Economy/Currency")" asp-page="/Economy/Currency"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 7v10M9 9.5c1-.8 5-.8 6 0M9 14.5c1 .8 5 .8 6 0"/></svg></span><span class="label">货币调账</span></a>
      <a class="@A("/Economy/Orders")" asp-page="/Economy/Orders"><span class="nav-ico"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg></span><span class="label">充值/补单</span></a>

      <div class="nav-sec">世界与区服</div>
      <a class="@A("/Realms")" asp-page="/Realms/Index"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></span><span class="label">区服</span></a>
      <a class="@A("/Realms/Merge")" asp-page="/Realms/Merge"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M8 6H4v4M16 6h4v4M8 18H4v-4M16 18h4v-4M7 8l5 4 5-4M7 16l5-4 5 4"/></svg></span><span class="label">合区计划</span></a>
      <a class="@A("/Ops/Reload")" asp-page="/Ops/Reload"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 4v6h-6"/></svg></span><span class="label">热重载</span></a>

      <div class="nav-sec">运营</div>
      <a class="@A("/Players")" asp-page="/Players/Online"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M16 19c0-2.5-2.5-4-6-4s-6 1.5-6 4"/><circle cx="10" cy="8" r="3"/><path d="M20 19c0-1.8-1.5-3-3.5-3.5M17 5.5a2.5 2.5 0 0 1 0 5"/></svg></span><span class="label">在线玩家</span></a>
      <a class="@A("/Players/Moderation")" asp-page="/Players/Moderation"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-3z"/></svg></span><span class="label">封禁/禁言</span></a>
      <a class="@A("/Mail")" asp-page="/Mail/Index"><span class="nav-ico"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 7 9-7"/></svg></span><span class="label">邮件</span></a>
      <a class="@A("/Announcements")" asp-page="/Announcements/Index"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M4 10v4h3l5 4V6L7 10H4z"/><path d="M16 9a4 4 0 0 1 0 6"/></svg></span><span class="label">公告</span></a>
      <a class="@A("/Ops/Siege")" asp-page="/Ops/Siege"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M4 20h16M6 20V10l6-5 6 5v10M10 20v-5h4v5"/></svg></span><span class="label">沙巴克</span></a>
      <a class="@A("/Cdk")" asp-page="/Cdk/Index"><span class="nav-ico"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2M8 13h8"/></svg></span><span class="label">CDK 卡密</span></a>

      <div class="nav-sec">记录 / 系统</div>
      <a class="@A("/Audit")" asp-page="/Audit/Index"><span class="nav-ico"><svg viewBox="0 0 24 24"><path d="M9 5h11v14H9z"/><path d="M4 5h3v14H4z"/><path d="M12 9h5M12 13h5"/></svg></span><span class="label">操作审计</span></a>
      <a class="@A("/SysAdmin/Users")" asp-page="/SysAdmin/Users"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 19c1.2-3 12.8-3 14 0"/></svg></span><span class="label">管理员</span></a>
      <a class="@A("/SysAdmin/Settings")" asp-page="/SysAdmin/Settings"><span class="nav-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9c.3.6.9 1 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></span><span class="label">连接设置</span></a>
    </nav>
  </aside>
  <div class="shell-main">
    <header class="app-topbar">
      <button type="button" class="tb-toggle" id="sidebar-toggle" title="折叠侧栏" aria-label="折叠侧栏">☰</button>
      <h1 class="tb-title">@ViewData["Title"]</h1>
      <form class="tb-search" method="get" action="/Studio" role="search">
        <input type="hidden" name="packId" value="@navPack" />
        <span aria-hidden="true">⌕</span>
        <input type="search" name="q" placeholder="全局搜索 ID / 名称 / 素材…" />
      </form>
      <div class="tb-right">
        <div class="user-chip">
          <span class="user-avatar">@initial</span>
          <span>@user</span>
          <span class="badge gold">@role</span>
          <a asp-page="/Account/Logout">退出</a>
        </div>
      </div>
    </header>
    <main class="main">
      @if (TempData["Flash"] is string flash)
      {
        <div class="flash">@flash</div>
      }
      @if (TempData["Error"] is string err)
      {
        <div class="flash err">@err</div>
      }
      @RenderBody()
    </main>
  </div>
</div>
}
else
{
  @RenderBody()
}
<div id="lightbox" class="lightbox" hidden><img alt="preview" /><button type="button" class="btn" id="lightbox-close">关闭</button></div>
<script src="~/js/admin.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
