@model (string PackId, string Title, string Kind, string ListPage, List<Legend.Admin.Pages.Studio.IndexModel.StudioEntityRow> Rows)
@{
  var packId = Model.PackId;
  var title = Model.Title;
  var kind = Model.Kind;
  var listPage = Model.ListPage;
  var rows = Model.Rows;
}
<div class="card">
  <div class="card-head">
    <h3>@title</h3>
    <a class="btn" href="@listPage?packId=@packId">全部</a>
    <a class="btn" href="@listPage?packId=@packId&missingOnly=true">缺图</a>
    <a class="btn btn-primary" asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@packId">新建</a>
  </div>
  @if (rows.Count == 0)
  {
    <div class="empty">暂无数据。<a asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@packId">新建一条</a></div>
  }
  else
  {
    <div class="entity-board">
    @foreach (var r in rows)
    {
      <a class="ecard @(r.ThumbUrl is null ? "missing" : "")" asp-page="/Entities/Edit" asp-route-kind="@kind" asp-route-packId="@packId" asp-route-id="@r.Id">
        <div class="ecard-preview">
          @if (r.ThumbUrl is not null)
          { <img class="lightbox-src" src="@r.ThumbUrl" alt="" loading="lazy" /> }
          else
          {
            <div class="empty-art">
              <strong>缺外观</strong>
              <span>点此配置 / 上传</span>
            </div>
          }
          <div class="ecard-overlay">
            <div class="name">@r.Name</div>
            <div class="id">@r.Id</div>
          </div>
        </div>
      </a>
    }
    </div>
  }
</div>
