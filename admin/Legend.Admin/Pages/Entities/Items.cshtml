@page
@model Legend.Admin.Pages.Entities.ItemsModel
@{ ViewData["Title"] = "物品/装备"; }
<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
  </form>
  <div class="toolbar">
    <a class="btn btn-primary" asp-page="/Configs/Edit" asp-route-packId="@Model.PackId" asp-route-path="configs/items.json">打开 JSON 编辑器</a>
    <a class="btn" asp-page="/Assets/Index" asp-route-packId="@Model.PackId" asp-route-kind="item">素材库（物品）</a>
    <span class="muted">文件 <code>configs/items.json</code> · 共 @Model.Rows.Count 条</span>
  </div>
</div>
<div class="card">
  <table class="data">
    <thead><tr><th>itemId</th><th>displayName</th><th>kind</th><th>slot</th><th>paperdoll</th><th>外观</th><th>摘要</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
      <tr>
        @foreach (var c in Model.Columns)
        {
          <td>@(row.ContainsKey(c) ? row[c] : "")</td>
        }
        <td>
          <a class="btn btn-sm" asp-page="/Assets/BindItem" asp-route-packId="@Model.PackId" asp-route-id="@row.GetValueOrDefault("itemId")">外观</a>
          @if (!string.IsNullOrEmpty(row.GetValueOrDefault("_look")))
          { <span class="badge ok">已绑</span> }
        </td>
        <td class="muted" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@row.GetValueOrDefault("_preview")</td>
      </tr>
    }
    </tbody>
  </table>
</div>
