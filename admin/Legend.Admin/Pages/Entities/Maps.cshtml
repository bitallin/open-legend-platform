@page
@model Legend.Admin.Pages.Entities.MapsModel
@{ ViewData["Title"] = "地图"; }
<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
  </form>
  <div class="toolbar">
    <a class="btn" asp-page="/Assets/Index" asp-route-packId="@Model.PackId" asp-route-kind="map_tile">素材库（地图）</a>
  </div>
</div>
<div class="card">
  <table class="data">
    <thead><tr><th>地图文件</th><th>大小</th><th></th></tr></thead>
    <tbody>
    @foreach (var f in Model.Maps)
    {
      var mapId = System.IO.Path.GetFileNameWithoutExtension(f.RelativePath);
      <tr>
        <td><code>@f.RelativePath</code></td>
        <td>@f.SizeBytes</td>
        <td>
          <a class="btn btn-sm" asp-page="/Configs/Edit" asp-route-packId="@Model.PackId" asp-route-path="@f.RelativePath">编辑 JSON</a>
          <a class="btn btn-sm btn-primary" asp-page="/Assets/BindMap" asp-route-packId="@Model.PackId" asp-route-id="@mapId">外观</a>
        </td>
      </tr>
    }
    </tbody>
  </table>
</div>
