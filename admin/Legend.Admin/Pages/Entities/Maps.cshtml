@page
@model Legend.Admin.Pages.Entities.MapsModel
@{ ViewData["Title"] = "地图"; }
<nav class="crumbs"><a asp-page="/Studio/Index" asp-route-packId="@Model.PackId">内容总览</a> / <span>@Model.Desc.TitleZh</span></nav>
<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
    <div>
      <label>搜索</label>
      <input type="text" name="q" value="@Model.Q" placeholder="ID / 名称" />
    </div>
    <div><button class="btn" type="submit">筛选</button></div>
  </form>
  <div class="toolbar">
    @if (Model.CanWrite)
    {
      <a class="btn btn-primary" asp-page="/Entities/Edit" asp-route-kind="maps" asp-route-packId="@Model.PackId">新建</a>
    }
    <a class="btn" asp-page="/Configs/Edit" asp-route-packId="@Model.PackId" asp-route-path="@(Model.Desc.IsMapFiles ? "maps/novice_plain.json" : Model.Desc.RelativePath)">JSON 兜底</a>
    <span class="muted">共 @Model.Rows.Count 条</span>
  </div>
</div>
<div class="card">
  @if (Model.Rows.Count == 0)
  {
    <div class="empty">暂无数据。@if (Model.CanWrite){<a asp-page="/Entities/Edit" asp-route-kind="maps" asp-route-packId="@Model.PackId">新建一条</a>}</div>
  }
  else
  {
  <div class="table-scroll">
  <table class="data">
    <thead>
      <tr>
        <th>图</th>
        @foreach (var c in Model.Desc.ListColumns)
        {
          <th>@c</th>
        }
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
      <tr>
        <td>@if (r.ThumbUrl is not null){<img class="thumb-sm lightbox-src" src="@r.ThumbUrl" alt="" />}else{<span class="muted">—</span>}</td>
        @foreach (var c in Model.Desc.ListColumns)
        {
          <td>@(r.Cols.GetValueOrDefault(c) ?? "")</td>
        }
        <td class="nowrap">
          <a class="btn btn-sm btn-primary" asp-page="/Entities/Edit" asp-route-kind="maps" asp-route-packId="@Model.PackId" asp-route-id="@r.Id">编辑</a>
          <a class="btn btn-sm" asp-page="/Assets/BindMap" asp-route-packId="@Model.PackId" asp-route-id="@r.Id">外观</a>
          @if (Model.CanWrite)
          {
            <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('删除 @r.Id ？');">
              <input type="hidden" name="packId" value="@Model.PackId" />
              <input type="hidden" name="id" value="@r.Id" />
              <button class="btn btn-sm btn-danger" type="submit">删</button>
            </form>
          }
        </td>
      </tr>
    }
    </tbody>
  </table>
  </div>
  }
</div>
