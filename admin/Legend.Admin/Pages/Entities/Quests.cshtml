@page
@model Legend.Admin.Pages.Entities.QuestsModel
@{ ViewData["Title"] = "任务"; }
<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
  </form>
  <div class="toolbar">
    <a class="btn btn-primary" asp-page="/Configs/Edit" asp-route-packId="@Model.PackId" asp-route-path="configs/quests.json">打开 JSON 编辑器</a>
    <span class="muted">文件 <code>configs/quests.json</code> · 共 @Model.Rows.Count 条（列表为摘要，完整字段以 JSON 为准）</span>
  </div>
</div>
<div class="card">
  <table class="data">
    <thead><tr><th>questId</th><th>title</th><th>displayName</th><th>摘要</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
      <tr>
        @foreach (var c in Model.Columns)
        {
          <td>@(row.ContainsKey(c) ? row[c] : "")</td>
        }
        <td class="muted" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@row.GetValueOrDefault("_preview")</td>
      </tr>
    }
    </tbody>
  </table>
</div>
