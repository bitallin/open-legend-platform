@page
@model Legend.Admin.Pages.Assets.UiSkinModel
@{ ViewData["Title"] = "UI 皮肤"; }
<nav class="crumbs"><a asp-page="/Studio/Index" asp-route-packId="@Model.PackId">内容总览</a> / <span>UI 皮肤</span></nav>
<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
  </form>
  <p class="muted">为登录底、HUD、红蓝球等槽位绑定素材；可增删自定义槽位。</p>
</div>

@if (Model.CanWrite)
{
<div class="card">
  <h3>新增槽位</h3>
  <form method="post" asp-page-handler="AddSlot" class="row">
    <input type="hidden" name="packId" value="@Model.PackId" />
    <div>
      <label>槽位名</label>
      <input type="text" name="newSlot" required pattern="[A-Za-z0-9_\-]{2,64}" placeholder="custom_banner" />
    </div>
    <div><button class="btn btn-primary" type="submit">添加</button></div>
  </form>
</div>
}

<div class="card">
  <div class="table-scroll">
  <table class="data">
    <thead><tr><th>预览</th><th>槽位</th><th>素材</th><th>备注</th><th></th></tr></thead>
    <tbody>
    @foreach (var slot in Model.SlotNames)
    {
      var aid = Model.SlotAssetId(slot);
      <tr>
        <td>
          @if (!string.IsNullOrEmpty(aid))
          { <img class="thumb-sm lightbox-src" src="/Assets/File?id=@aid&thumb=1" alt="" /> }
          else { <span class="muted">—</span> }
        </td>
        <td><code>@slot</code></td>
        <td>
          @if (Model.CanWrite)
          {
            <form method="post" class="row" style="margin:0">
              <input type="hidden" name="packId" value="@Model.PackId" />
              <input type="hidden" name="slot" value="@slot" />
              <div style="min-width:220px">
                <select name="assetId">
                  <option value="">（清空）</option>
                  @foreach (var a in Model.UiAssets)
                  {
                    <option value="@a.Id" selected="@(a.Id==aid)">@a.FileName (@a.Id[..8])</option>
                  }
                </select>
              </div>
              <div style="min-width:140px">
                <input type="text" name="note" value="@Model.SlotNote(slot)" placeholder="备注" />
              </div>
              <div><button class="btn btn-sm btn-primary" type="submit">保存</button></div>
            </form>
          }
          else
          {
            <code>@aid</code>
          }
        </td>
        <td class="muted">@Model.SlotNote(slot)</td>
        <td>
          @if (Model.CanWrite)
          {
            <form method="post" asp-page-handler="RemoveSlot" onsubmit="return confirm('删除槽位 @slot？');">
              <input type="hidden" name="packId" value="@Model.PackId" />
              <input type="hidden" name="slot" value="@slot" />
              <button class="btn btn-sm btn-danger" type="submit">删槽</button>
            </form>
          }
        </td>
      </tr>
    }
    </tbody>
  </table>
  </div>
  @if (Model.SlotNames.Count == 0)
  {
    <div class="empty">暂无槽位，请先添加。</div>
  }
</div>
