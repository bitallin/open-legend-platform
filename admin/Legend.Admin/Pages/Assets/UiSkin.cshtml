@page
@model Legend.Admin.Pages.Assets.UiSkinModel
@{
  ViewData["Title"] = "UI 皮肤";
  string Zh(string slot) => slot switch
  {
    "login_bg" => "登录背景",
    "hud_frame" => "HUD 外框",
    "hp_orb" => "生命球",
    "mp_orb" => "魔法球",
    "menu_ring" => "环形菜单",
    "window_frame" => "窗口边框",
    "item_icon_atlas" => "物品图标图集",
    "chat_panel" => "聊天面板",
    "minimap_frame" => "小地图框",
    "bag_panel" => "背包面板",
    "skill_bar" => "技能栏",
    _ => slot
  };
}
<nav class="crumbs"><a asp-page="/Studio/Index" asp-route-packId="@Model.PackId">内容总览</a> / <span>UI 皮肤</span></nav>
<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
  </form>
  <p class="muted" style="margin:0">为登录底、HUD、红蓝球等槽位绑定素材；每个槽位以预览框展示，空槽显示虚线占位。</p>
</div>

@if (Model.CanWrite)
{
<div class="card">
  <div class="card-head"><h3>新增槽位</h3></div>
  <form method="post" asp-page-handler="AddSlot" class="row">
    <input type="hidden" name="packId" value="@Model.PackId" />
    <div>
      <label>槽位名</label>
      <input type="text" name="newSlot" required pattern="[A-Za-z0-9_\-]{2,64}" placeholder="custom_banner" />
    </div>
    <div><button class="btn btn-primary" type="submit">添加</button></div>
  </form>
</div>
}

@if (Model.SlotNames.Count == 0)
{
  <div class="card"><div class="empty">暂无槽位，请先添加。</div></div>
}
else
{
<div class="slot-board">
@foreach (var slot in Model.SlotNames)
{
  var aid = Model.SlotAssetId(slot);
  <div class="slot-card">
    <div class="slot-frame">
      @if (!string.IsNullOrEmpty(aid))
      { <img class="lightbox-src" src="/api/media/@aid?thumb=true" alt="@slot" /> }
      else
      { <div class="slot-empty">未绑定<br/><strong>@Zh(slot)</strong></div> }
    </div>
    <div class="slot-body">
      <div class="slot-title">@Zh(slot)</div>
      <div class="slot-key">@slot</div>
      @if (Model.CanWrite)
      {
        <form method="post">
          <input type="hidden" name="packId" value="@Model.PackId" />
          <input type="hidden" name="slot" value="@slot" />
          <label>素材</label>
          <select name="assetId" data-preview-target="prev-@slot">
            <option value="">（清空）</option>
            @foreach (var a in Model.UiAssets)
            {
              <option value="@a.Id" selected="@(a.Id==aid)">@a.FileName (@a.Id[..Math.Min(8,a.Id.Length)])</option>
            }
          </select>
          <label>备注</label>
          <input type="text" name="note" value="@Model.SlotNote(slot)" placeholder="备注" />
          <div class="toolbar" style="margin:0">
            <button class="btn btn-sm btn-primary" type="submit">保存</button>
            <button class="btn btn-sm btn-danger" type="submit" formaction="?handler=RemoveSlot" formmethod="post" onclick="return confirm('删除槽位 @slot？');">删槽</button>
          </div>
        </form>
      }
      else
      {
        <div class="muted tiny">@aid</div>
        <div class="muted tiny">@Model.SlotNote(slot)</div>
      }
    </div>
  </div>
}
</div>
}
