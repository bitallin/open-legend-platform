@page
@model Legend.Admin.Pages.Account.LoginModel
@{
    ViewData["Title"] = "登录";
    Layout = "_Layout";
}
<div class="login-wrap card">
  <h1 style="margin-top:0">Open Legend 运营后台</h1>
  <p class="muted">生产级配置与运维控制台（非游戏画面）</p>
  @if (!string.IsNullOrEmpty(Model.ErrorMessage))
  {
    <div class="flash err">@Model.ErrorMessage</div>
  }
  <form method="post">
    <label>用户名</label>
    <input asp-for="Username" autocomplete="username" />
    <label>密码</label>
    <input asp-for="Password" type="password" autocomplete="current-password" />
    <button class="btn btn-primary" type="submit">登录</button>
  </form>
  <p class="muted" style="margin-top:1rem;font-size:0.8rem">开发种子：admin / LegendAdmin!2026</p>
</div>
