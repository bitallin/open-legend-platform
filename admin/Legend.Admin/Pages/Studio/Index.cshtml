@page "/Studio"
@model Legend.Admin.Pages.Studio.IndexModel
@{ ViewData["Title"] = "内容总览"; }
<nav class="crumbs"><a asp-page="/Index">仪表盘</a> / <span>内容总览</span></nav>

<section class="studio-hero">
  <div class="toolbar" style="margin:0 0 4px">
    <h2 style="flex:1">版本包 · <code>@Model.PackId</code></h2>
    <a class="btn btn-primary" asp-page="/Assets/Index" asp-route-packId="@Model.PackId">上传素材</a>
    <a class="btn" asp-page="/Entities/Edit" asp-route-kind="monsters" asp-route-packId="@Model.PackId">新建怪物</a>
  </div>
  <p class="muted" style="margin:0">图像优先的内容工作室：一眼看清素材、外观绑定与各域配置健康度。</p>
  <div class="chips">
    <span class="badge gold">包 @Model.PackId</span>
    <span class="badge ok">素材 @Model.Counts.GetValueOrDefault("media")</span>
    <span class="badge info">配置文件 @Model.ConfigFileCount</span>
    <span class="badge @(Model.UiSlotBound==Model.UiSlotTotal && Model.UiSlotTotal>0 ? "ok" : "warn")">UI 槽 @Model.UiSlotBound/@Model.UiSlotTotal</span>
    <span class="badge @(Model.MissingLookCount==0 ? "ok" : "warn")">缺外观实体 @Model.MissingLookCount</span>
  </div>
</section>

<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.Id</option>
        }
      </select>
    </div>
    <div style="flex:2">
      <label>全局搜索（ID / 名称 / 素材）</label>
      <input type="text" name="q" value="@Model.Q" placeholder="例如 slime、木刀、login_bg" />
    </div>
    <div>
      <label>素材类型</label>
      <select name="mediaKind">
        <option value="all" selected="@(Model.MediaKind=="all")">全部</option>
        @foreach (var k in Legend.Admin.Services.MediaLibraryService.Kinds)
        {
          <option value="@k" selected="@(Model.MediaKind==k)">@k</option>
        }
      </select>
    </div>
    <div>
      <label>&nbsp;</label>
      <label class="tiny" style="display:flex;gap:.35rem;align-items:center;color:var(--text)">
        <input type="checkbox" name="missingOnly" value="true" @(Model.MissingOnly ? "checked" : null) /> 仅缺图实体
      </label>
    </div>
    <div><button class="btn btn-primary" type="submit">应用</button></div>
  </form>
</div>

@if (Model.SearchHits.Count > 0)
{
<div class="card">
  <div class="card-head"><h3>搜索结果 · @Model.SearchHits.Count</h3></div>
  <div class="search-hit-grid">
  @foreach (var h in Model.SearchHits.Take(60))
  {
    var href = h.Kind == "media"
      ? $"/Assets?packId={Model.PackId}&q={Uri.EscapeDataString(h.Id)}"
      : $"/Entities/Edit?kind={h.Kind}&packId={Model.PackId}&id={Uri.EscapeDataString(h.Id)}";
    <a class="search-hit" href="@href">
      @if (h.ThumbUrl is not null){<img class="lightbox-src" src="@h.ThumbUrl" alt="" />}else{<div class="ph">无图</div>}
      <div>
        <div class="badge">@h.KindZh</div>
        <div style="font-weight:650;margin-top:4px">@h.Name</div>
        <div class="tiny muted mono">@h.Id</div>
      </div>
    </a>
  }
  </div>
</div>
}

<div class="kpi-grid">
  <a class="kpi" href="/Entities/Monsters?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("monsters")</div><div class="l">怪物</div><svg class="spark" viewBox="0 0 48 20"><polyline fill="none" stroke="currentColor" stroke-width="2" points="0,14 8,10 16,12 24,6 32,9 40,4 48,8"/></svg></a>
  <a class="kpi" href="/Entities/Items?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("items")</div><div class="l">物品</div><svg class="spark" viewBox="0 0 48 20"><polyline fill="none" stroke="currentColor" stroke-width="2" points="0,12 10,11 20,13 28,7 36,8 48,5"/></svg></a>
  <a class="kpi" href="/Entities/Maps?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("maps")</div><div class="l">地图</div><svg class="spark" viewBox="0 0 48 20"><polyline fill="none" stroke="currentColor" stroke-width="2" points="0,10 12,10 20,8 30,12 40,9 48,11"/></svg></a>
  <a class="kpi" href="/Entities/Npcs?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("npcs")</div><div class="l">NPC</div></a>
  <a class="kpi" href="/Entities/Skills?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("skills")</div><div class="l">技能</div></a>
  <a class="kpi" href="/Entities/Quests?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("quests")</div><div class="l">任务</div></a>
  <a class="kpi" href="/Entities/Shops?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("shops")</div><div class="l">商店</div></a>
  <a class="kpi" href="/Entities/Loot?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("loot")</div><div class="l">掉落</div></a>
  <a class="kpi" href="/Assets?packId=@Model.PackId"><div class="v">@Model.Counts.GetValueOrDefault("media")</div><div class="l">素材</div></a>
  <a class="kpi" href="/Assets/UiSkin?packId=@Model.PackId"><div class="v">@Model.UiSlotBound/@Model.UiSlotTotal</div><div class="l">UI 槽已绑</div></a>
  <a class="kpi" href="/Configs?packId=@Model.PackId"><div class="v">@Model.ConfigFileCount</div><div class="l">配置文件</div></a>
</div>

<div class="card">
  <div class="card-head">
    <h3>素材墙</h3>
    <div class="seg-tabs" style="margin:0">
      <a class="@(Model.MediaKind=="all"?"active":"")" href="?packId=@Model.PackId&mediaKind=all&missingOnly=@Model.MissingOnly.ToString().ToLowerInvariant()">全部</a>
      @foreach (var k in Legend.Admin.Services.MediaLibraryService.Kinds.Take(8))
      {
        <a class="@(Model.MediaKind==k?"active":"")" href="?packId=@Model.PackId&mediaKind=@k&missingOnly=@Model.MissingOnly.ToString().ToLowerInvariant()">@k</a>
      }
    </div>
    <a class="btn btn-primary" asp-page="/Assets/Index" asp-route-packId="@Model.PackId">管理素材</a>
  </div>
  @if (Model.RecentMedia.Count == 0)
  {
    <div class="empty">暂无素材。<a asp-page="/Assets/Index" asp-route-packId="@Model.PackId">去上传</a></div>
  }
  else
  {
    <div class="media-wall">
      @foreach (var a in Model.RecentMedia)
      {
        <a class="media-tile" asp-page="/Assets/Index" asp-route-packId="@Model.PackId" asp-route-q="@a.Id" title="@a.FileName">
          <img class="lightbox-src" src="/Assets/File?id=@a.Id&thumb=1" alt="@a.FileName" loading="lazy" />
          <span class="chip badge kind kind-@a.Kind">@a.Kind</span>
          <span class="cap">@a.FileName</span>
        </a>
      }
    </div>
  }
</div>

@await Html.PartialAsync("_StudioEntityStrip", (Model.PackId, "怪物", "monsters", "/Entities/Monsters", Model.MonsterRows))
@await Html.PartialAsync("_StudioEntityStrip", (Model.PackId, "物品/装备", "items", "/Entities/Items", Model.ItemRows))
@await Html.PartialAsync("_StudioEntityStrip", (Model.PackId, "地图", "maps", "/Entities/Maps", Model.MapRows))
@await Html.PartialAsync("_StudioEntityStrip", (Model.PackId, "NPC", "npcs", "/Entities/Npcs", Model.NpcRows))

<div class="card">
  <div class="card-head"><h3>快捷入口</h3></div>
  <div class="toolbar" style="margin:0">
    <a class="btn" asp-page="/Entities/Skills" asp-route-packId="@Model.PackId">技能</a>
    <a class="btn" asp-page="/Entities/Quests" asp-route-packId="@Model.PackId">任务</a>
    <a class="btn" asp-page="/Entities/Shops" asp-route-packId="@Model.PackId">商店</a>
    <a class="btn" asp-page="/Entities/Loot" asp-route-packId="@Model.PackId">掉落</a>
    <a class="btn" asp-page="/Entities/Gameplay" asp-route-packId="@Model.PackId">玩法开关</a>
    <a class="btn" asp-page="/Assets/UiSkin" asp-route-packId="@Model.PackId">UI 皮肤</a>
    <a class="btn" asp-page="/Configs/Index" asp-route-packId="@Model.PackId">配置目录</a>
  </div>
</div>
