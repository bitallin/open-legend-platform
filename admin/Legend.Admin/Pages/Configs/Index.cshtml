@page
@model Legend.Admin.Pages.Configs.IndexModel
@{ ViewData["Title"] = "配置目录"; }
<nav class="crumbs"><a asp-page="/Studio/Index" asp-route-packId="@Model.PackId">内容总览</a> / <span>配置目录</span></nav>
<div class="card">
  <form method="get" class="row">
    <div>
      <label>版本包</label>
      <select name="packId" onchange="this.form.submit()">
        @foreach (var p in Model.Packs)
        {
          <option value="@p.Id" selected="@(p.Id == Model.PackId)">@p.DisplayName (@p.Id)</option>
        }
      </select>
    </div>
  </form>
</div>

@if (Model.CanWrite)
{
<div class="card">
  <h3>新建 JSON 文件</h3>
  <form method="post" asp-page-handler="Create" class="row">
    <input type="hidden" name="packId" value="@Model.PackId" />
    <div style="flex:2">
      <label>相对路径</label>
      <input type="text" name="relativePath" required placeholder="configs/my_feature.json" />
    </div>
    <div style="flex:2">
      <label>初始 JSON</label>
      <input type="text" name="initialJson" value="{}" />
    </div>
    <div><button class="btn btn-primary" type="submit">创建</button></div>
  </form>
  <h3>复制文件</h3>
  <form method="post" asp-page-handler="Copy" class="row">
    <input type="hidden" name="packId" value="@Model.PackId" />
    <div>
      <label>源路径</label>
      <input type="text" name="fromRel" required placeholder="configs/items.json" />
    </div>
    <div>
      <label>目标路径</label>
      <input type="text" name="toRel" required placeholder="configs/items_backup.json" />
    </div>
    <div><button class="btn" type="submit">复制</button></div>
  </form>
</div>
}

<div class="card">
  <div class="table-scroll">
  <table class="data">
    <thead><tr><th>相对路径</th><th>类型</th><th>大小</th><th>修改(UTC)</th><th></th></tr></thead>
    <tbody>
    @foreach (var f in Model.Files)
    {
      <tr>
        <td><code>@f.RelativePath</code></td>
        <td><span class="badge">@f.Kind</span></td>
        <td>@f.SizeBytes</td>
        <td>@f.LastWriteUtc.ToString("u")</td>
        <td class="nowrap">
          <a class="btn btn-sm" asp-page="/Configs/Edit" asp-route-packId="@Model.PackId" asp-route-path="@f.RelativePath">编辑</a>
          @if (Model.CanWrite)
          {
            <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('删除 @f.RelativePath ？');">
              <input type="hidden" name="packId" value="@Model.PackId" />
              <input type="hidden" name="path" value="@f.RelativePath" />
              <label class="tiny" style="display:inline-flex;gap:.25rem;align-items:center;margin:0 .35rem">
                <input type="checkbox" name="allowNonEmpty" value="true" /> 允许非空
              </label>
              <button class="btn btn-sm btn-danger" type="submit">删</button>
            </form>
          }
        </td>
      </tr>
    }
    </tbody>
  </table>
  </div>
  @if (Model.Files.Count == 0)
  {
    <div class="empty">该包暂无配置文件。</div>
  }
</div>
